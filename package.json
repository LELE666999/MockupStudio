    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^4.2.2",
    "three": "0.173.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^5.0.0",
